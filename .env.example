# Financial Analysis Agent Crew - Environment Variables
# Copy this file to .env and fill in your API keys

# LLM providers, tried in this order; only providers with a key are used.
# If one is rate-limited or down, the request falls back to the next.
LLM_PROVIDERS=mistral,groq,gemini

# Free keys - set at least one
MISTRAL_API_KEY=   # https://console.mistral.ai
GROQ_API_KEY=      # https://console.groq.com
GEMINI_API_KEY=    # https://aistudio.google.com/apikey

# Optional model overrides (defaults: mistral-small-latest, openai/gpt-oss-20b, gemini-flash-latest)
# MISTRAL_MODEL=
# GROQ_MODEL=
# GEMINI_MODEL=

# Optional: News API Key (Free at https://newsapi.org) - DuckDuckGo news is used otherwise
NEWS_API_KEY=

# Optional: Output directory for reports (default: output/reports)
OUTPUT_DIR=output/reports

# Optional: Default days of historical data (default: 30)
DEFAULT_DAYS_BACK=30
