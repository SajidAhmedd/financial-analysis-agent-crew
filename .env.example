# Financial Analysis Agent Crew - Environment Variables
# Copy this file to .env and fill in your API keys

# Required: Groq API Key (Free at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Optional: News API Key (Free at https://newsapi.org)
NEWS_API_KEY=your_news_api_key_here

# Optional: Gemini API Key (Not currently used, kept for compatibility)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Output directory for reports (default: output/reports)
OUTPUT_DIR=output/reports

# Optional: Default days of historical data (default: 30)
DEFAULT_DAYS_BACK=30
